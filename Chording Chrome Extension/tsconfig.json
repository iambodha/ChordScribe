{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "background/**/*.ts",
    "content/**/*.ts",
    "shared/**/*.ts",
    "popup/**/*.tsx",
    "options/**/*.tsx",
    "utils/**/*.ts"
  ],
  "exclude": [
    "**/*.d.ts",
    "dist",
    "node_modules"
  ]
}
